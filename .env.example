# HTTP port
PORT=3000

# Postgres URL for host/port/db/user (password in URL is ignored — see DB_PASSWORD_FILE)
DB_URL=postgres://app_user@127.0.0.1:21110/shop

# Path to DB password file (rotated by rotate.sh without app restart)
DB_PASSWORD_FILE=secrets/db_password

# Logging level: debug | info | warn | error. Optional, default info.
LOG_LEVEL=info

# Timeout for external calls in ms. Optional, default 5000.
TIMEOUT_MS=5000

# HMAC secret for cursor encoding (fake value in example)
CURSOR_HMAC_SECRET=CHANGE_ME_CURSOR_HMAC_SECRET
