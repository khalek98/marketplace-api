# HTTP port
PORT=3000

# Postgres URL for host/port/db/user (username in URL is ignored — taken from DB_AUTH_FILE)
# Host/port must be PgBouncer (compose publishes 21111). Direct Postgres is 21110 (admin only).
DB_URL=postgres://ignored@127.0.0.1:21111/shop

# RabbitMQ AMQP URL (compose publishes 21130). Management UI is 21131 — not this URL.
BROKER_URL=amqp://USER:PASSWORD@127.0.0.1:21130

# Cache Redis (compose publishes 21140 — allkeys-lru). Same vault path as DB_URL.
REDIS_URL=redis://127.0.0.1:21140

# Jobs / sessions Redis (compose publishes 21141 — noeviction). Not the cache instance.
REDIS_QUEUE_URL=redis://127.0.0.1:21141

# Path to DB authentication file (rotated by rotate.sh without app restart)
DB_AUTH_FILE=secrets/db_auth

# Logging level: debug | info | warn | error. Optional, default info.
LOG_LEVEL=info

# Timeout for external calls in ms. Optional, default 5000.
TIMEOUT_MS=5000

# HMAC secret for cursor encoding (fake value in example)
CURSOR_HMAC_SECRET=CHANGE_ME_CURSOR_HMAC_SECRET

# Active signing key id. Real value lives in the vault, not in this file.
JWT_KID=

# ES256 private key: base64 of the PKCS#8 PEM. Empty here on purpose.
JWT_PRIVATE_KEY=

# ES256 public key: base64 of the SPKI PEM.
JWT_PUBLIC_KEY=

# HMAC pepper for refresh-token hashes. Not a default and not a real pepper.
REFRESH_TOKEN_PEPPER=
