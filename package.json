{
  "name": "marketplace-api",
  "version": "0.1.0",
  "description": "Marketplace API (course project)",
  "private": true,
  "scripts": {
    "build": "tsc",
    "start": "npm run build && node dist/main.js",
    "dev": "nest start --watch",
    "openapi:lint": "redocly lint openapi/openapi.yaml",
    "openapi:bundle": "redocly bundle openapi/openapi.yaml -o spec.json",
    "test": "node --test test/**/*.test.js",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nestjs/common": "^11.2.3",
    "@nestjs/core": "^11.2.3",
    "@nestjs/platform-express": "^11.2.3",
    "express": "4.22.2",
    "express-openapi-validator": "5.6.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@redocly/cli": "2.46.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "prettier": "3.9.6",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
